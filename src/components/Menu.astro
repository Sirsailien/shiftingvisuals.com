---
import { NAV_PAGES, href, type PageKey } from '../lib/pages';

interface Props {
  current: PageKey;
}

const { current } = Astro.props;
const listId = `menu-${current}`;
---

<nav class="menu" aria-label="Pages">
  <button class="menu__toggle label" type="button" aria-expanded="false" aria-controls={listId} data-menu-toggle>
    Menu
  </button>
  <ul class="menu__list" id={listId}>
    {
      NAV_PAGES.map((p) => (
        <li>
          <a class="label" href={href(p.route)} aria-current={p.key === current ? 'page' : undefined}>
            {p.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .menu {
    position: relative;
  }

  .menu__list {
    display: flex;
    gap: 28px;
  }

  .menu__list a,
  .menu__toggle {
    color: var(--grey);
    transition: color 0.2s;
  }

  .menu__list a:hover,
  .menu__toggle:hover,
  .menu__list a[aria-current='page'] {
    color: var(--white);
  }

  .menu__toggle {
    display: none;
    padding: 8px 0 8px 12px; /* bigger tap target */
  }

  @media (max-width: 760px) {
    .menu__toggle {
      display: block;
    }

    .menu__list {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      flex-direction: column;
      gap: 0;
      min-width: 180px;
      background: var(--black);
      border: var(--line);
    }

    .menu[data-open] .menu__list {
      display: flex;
    }

    .menu__list a {
      display: block;
      padding: 14px 16px;
    }

    .menu__list li + li {
      border-top: var(--line);
    }
  }
</style>
